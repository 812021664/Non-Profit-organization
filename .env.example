# `/api` works with `npm run dev` when the Spring Boot server is running.
# Leave blank for a completely local browser-only workspace.
VITE_API_BASE_URL=/api

# Public app environment only. Never place a private AI or database key in Vite env vars.
VITE_ENVIRONMENT=development

# Optional backend route used by the Giving Assistant. No browser-side secret is required.
VITE_ASSISTANT_ENDPOINT=
